{
    "nodejs": true,
    "additional_trust_anchors": "",
    "private": true,
    "keywords": [
        "DuckieTV",
        "bittorrent",
        "series",
        "shows",
        "trakt",
        "tv",
        "utorrent"
    ],
    "devDependencies": {
        "@types/node": "26.6.2",
        "babel-eslint": "^10.0.1",
        "eslint": "^5.11.1",
        "eslint-plugin-angular": "^4.0.0",
        "jasmine-core": "^5.7.1",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "^3.2.0",
        "karma-jasmine": "^5.1.0",
        "karma-mocha-reporter": "^2.2.5",
        "requirejs": "^2.1.0",
        "typescript": "5.9.3",
        "ws": "^8.21.3"
    },
    "author": "DuckieTV",
    "user-agent": "%name v%ver %osinfo",
    "window": {
        "show": false,
        "always_on_top": false,
        "as_desktop": true,
        "exe_icon": "./img/logo/icon128.png",
        "frame": true,
        "fullscreen": false,
        "height": 820,
        "icon": "./img/logo/icon128.png",
        "mac_app_icon": "./img/logo/duckietv.icns",
        "mac_icon": "./img/logo/duckietv.icns",
        "min_height": 572,
        "min_width": 840,
        "position": "center",
        "resizable": true,
        "show_in_taskbar": true,
        "title": "DuckieTV Standalone v1.1.7",
        "transparent": false,
        "visible": true,
        "width": 1100
    },
    "version": "1.1.7",
    "inject_js_start": "",
    "inject_js_end": "",
    "main": "tab.html",
    "chromium-args": "--flag-switches-begin --disable-features=HighEfficiencyModeAvailable --flag-switches-end",
    "description": "DuckieTV helps you manage your favorite TV Shows on a sweet calendar",
    "scripts": {
        "locales:check": "node scripts/validate-locales.js",
        "nw:fetch": "node scripts/nwjs/fetch.cjs",
        "nw:migrate": "node scripts/nwjs/migrate.cjs",
        "nw:package": "node scripts/nwjs/package.cts",
        "nw:probe": "node scripts/nwjs/probe.cjs",
        "nw:verify-evidence": "node scripts/nwjs/verify-evidence.cjs",
        "test:nw": "node scripts/nwjs/test.cjs",
        "test:startup": "node --test tests/LoginStartup.test.cjs",
        "scripts:typecheck": "tsc --project tsconfig.scripts.json",
        "verify:nw": "node scripts/nwjs/verify.cjs",
        "test": "karma start --single-run",
        "test-watch": "karma start --no-single-run --auto-watch --browsers ChromeHeadless",
        "test-debug": "karma start --no-single-run --auto-watch --browsers Chrome"
    },
    "webkit": {
        "java": false,
        "page-cache": true,
        "plugin": false
    },
    "js-flags": "",
    "license": "SEE LICENSE IN LICENSE.md",
    "name": "DuckieTV-Standalone-SQLite",
    "node-main": "--no-experimental-webstorage js/nwjs/node-main.cjs",
    "default_locale": "en",
    "bg-script": "standalone-background.js",
    "dom_storage_quota": 50
}
